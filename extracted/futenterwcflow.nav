{
	"name":"futEnterWCFlow"
	, "initial":
	{
		"targets":["EnterWC"]
	}
	,"transitions":
	[
		{
			"event":"GotoGameHubWC"
			,"targets":["worldCup"]
		}
	]
	,"states":
	[
		{
			"name":"EnterWC"
			,"onEnter":
			[

				["loadViewModel",["futloginwcviewmodel"]]
				,["loadView",["screen", "external/ion_fut/screens/worldcup/EnterWC"]]
			]
			,"onExit":
			[
				["unloadView",["screen", "external/ion_fut/screens/worldcup/EnterWC"]]
				,["unloadViewModel",["futloginwcviewmodel"]]		
			]
			,"transitions":
			[
				{
					"event":"advance"
					,"targets":["futLogIn2"]
				}
				,{
					"event":"GotoSupportNation"
					,"targets":["SupportNation"]
				}
			]
		}
		,{
			"name":"EnterWC_GotoStore"
			,"onEnter":
			[

				["loadViewModel",["futgamehubwcviewmodel"]]
				,["loadView",["screen", "external/ion_fut/screens/worldcup/EnterWC"]]
			]
			,"onExit":
			[
				["unloadView",["screen", "external/ion_fut/screens/worldcup/EnterWC"]]
				,["unloadViewModel",["futgamehubwcviewmodel"]]		
			]
			,"transitions":
			[
				{
					"event":"advance"
					,"targets":["futLogIn2_GotoStore"]
				}
				,{
					"event":"GotoSupportNation"
					,"targets":["SupportNation"]
				}
			]
		}
		,{
			"name":"SupportNation"
			,"onEnter":
			[
				["loadViewModel",["futgamehubwcviewmodel"]]
				,["loadView",["screen", "external/ion_fut/screens/worldcup/SupportNation"]]
			]
			,"onExit":
			[
				["unloadView",["screen", "external/ion_fut/screens/worldcup/SupportNation"]]
				,["unloadViewModel",["futgamehubwcviewmodel"]]				
			]
			,"transitions":
			[
				{
					"event":"back"
					,"targets":["back"]
				}
				,{
					"event":"advance"
					,"targets":["futLogIn2"]
				}
				,{
					"event":"exitWC"
					,"targets":["back"]
				}
			]
		}
		,{
			"name":"futLogIn2"
			,"onEnter":
			[
				["loadView",["screen", "external/ion_fut/screens/fcc_login2"]]
			]
			,"onExit":
			[
				["unloadView",["screen", "external/ion_fut/screens/fcc_login2"]]
			]
			,"transitions":
			[
				{
					"event":"advance"
					,"targets":["worldCup"]
				}
				,{
					"event":"GotoNewItemScreen"
					,"targets":["newItems"]
				}
				,{
					"event":"GotoStarterSquad"
					,"targets":["futSquadsWC"]
				}
			]
		}
		,{
			"name":"futLogIn2_GotoStore"
			,"onEnter":
			[
				["loadView",["screen", "external/ion_fut/screens/fcc_login2"]]
			]
			,"onExit":
			[
				["unloadView",["screen", "external/ion_fut/screens/fcc_login2"]]
			]
			,"transitions":
			[
				{
					"event":"advance"
					,"targets":["worldCup_GotoStore"]
				}
				,{
					"event":"GotoNewItemScreen"
					,"targets":["newItems"]
				}
				,{
					"event":"GotoStarterSquad"
					,"targets":["futSquadsWC"]
				}
			]
		}
		,{
			"name":"worldCup"
			,"type":"external"
			,"file":"fut/futGameHubWCFlow.nav"
			,"inputs":
			{
				"worldCup_GotoStore":"GameHubWC_GotoStore"
			}
			,"outputs":
			{
				"back":"back"
			}
		}
		,{
			"name":"newItems"
			,"type":"external"
			,"file":"fut/futNewItemsWCFlow.nav"
			,"outputs":
			{
				"back":"worldCup"
			}
		}
		,{
			"name":"futSquadsWC"
			,"type":"external"
			,"file":"fut/squads/futSquadsWCFlow.nav"
			,"outputs":
			{
				"BackToOffline":"none"
				,"BackToOnline":"none"				
				,"back":"back"
				,"advance":"worldCup"
				,"backToOfflineHub":"none"
				,"backToOnlineHub":"none"
				,"exitWC":"back"
			}
		}
		,{
			"name":"none"
		}
	]
}