{
  "name": "fifa-t3db",
  "version": "0.0.2",
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz",
    "url": "https://github.com/Celtian"
  },
  "license": "MIT",
  "private": false,
  "description": "Portable TypeScript reader and editor for FIFA PC t3db databases",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  },
  "engines": {
    "node": ">=24",
    "npm": "please-use-bun"
  },
  "keywords": [
    "fifa",
    "fifa-games",
    "t3db",
    "database",
    "huffman",
    "typescript",
    "browser"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
